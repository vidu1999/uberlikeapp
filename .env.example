# Cloud database — pick ONE (both have a free tier).
# Copy to .env and fill in. Never commit .env.

# --- Supabase (required for live data) ---
# User, Shop, and Rider apps fetch shops / menu_items / orders / accounts
# from these tables. Run server/schema.sql once in SQL Editor.
# Settings → API → Project URL + anon key (and optional service_role).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_ANON_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Firebase Realtime Database ---
# 1. Create a project at https://console.firebase.google.com
# 2. Build → Realtime Database → Create
# 3. Project settings → Service accounts → Database secrets
# FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# FIREBASE_SECRET=YOUR_DATABASE_SECRET

# --- Didit ID verification (NIC + driving licence). Secret stays on the server. ---
# Create a secret API key at https://business.didit.me → Developers → API keys.
# Use the secret key (not a webhook secret). Do not IP-lock it (Cloudflare IPs change).
# Standalone APIs (server-only): ID, POA, AML, face, KYB, email/phone OTP.
# Rider selfie uses POST /v3/passive-liveness/ (Mode B). Same secret key.
# Free 500 KYC/month: hosted sessions POST /v3/session/ (ID + liveness + face match + IP).
# Workflow must be Free KYC only — no AML / NFC / phone — and it must be Published.
# Didit → Workflows → create OCR + LIVENESS + FACE_MATCH → Publish → paste id:
# DIDIT_WORKFLOW_ID=
# POST /v3/id-verification/ returns 403 if the key is wrong, locked, or out of credits.
# DIDIT_API_KEY=
# Webhook URL to paste in Didit → API & Webhooks:
# https://quickbite-2ao.pages.dev/webhooks/didit
# (alias) https://quickbite-2ao.pages.dev/api/webhooks/didit
# DIDIT_WEBHOOK_SECRET=
# DIDIT_WEBHOOK_SECRET_PREVIOUS=

# --- OpenRouter (Help & Support AI). Secret stays on the server — never in the client. ---
# Cloudflare Pages → Settings → Environment variables (Production):
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# --- Payments.lk (card checkout; secret stays on the server) ---
# Sandbox key from https://app.payments.lk/admin/developers
# PAYMENTS_LK_SECRET_KEY=sk_test_...
# Webhook URL to paste: https://quickbite-2ao.pages.dev/webhooks/payments-lk
# PAYMENTS_LK_WEBHOOK_SECRET=whsec_...
