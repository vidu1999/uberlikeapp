# Cloud database — pick ONE (both have a free tier).
# Copy to .env and fill in. Never commit .env.

# --- Supabase (recommended) ---
# 1. Create a project at https://supabase.com
# 2. Run server/schema.sql in SQL Editor (creates tables + demo shops/orders)
# 3. Settings → API → Project URL + service_role key
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_ANON_KEY

# --- Firebase Realtime Database ---
# 1. Create a project at https://console.firebase.google.com
# 2. Build → Realtime Database → Create
# 3. Project settings → Service accounts → Database secrets
# FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# FIREBASE_SECRET=YOUR_DATABASE_SECRET
