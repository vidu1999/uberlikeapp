# Cloud database — pick ONE (both have a free tier).
# Copy to .env and fill in. Never commit .env.

# --- Supabase (required for live data) ---
# User, Shop, and Rider apps fetch shops / menu_items / orders / accounts
# from these tables. Run server/schema.sql once in SQL Editor.
# Settings → API → Project URL + anon key (and optional service_role).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_OR_ANON_KEY
SUPABASE_ANON_KEY=YOUR_ANON_KEY

# --- Firebase Realtime Database ---
# 1. Create a project at https://console.firebase.google.com
# 2. Build → Realtime Database → Create
# 3. Project settings → Service accounts → Database secrets
# FIREBASE_DB_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com
# FIREBASE_SECRET=YOUR_DATABASE_SECRET

# --- Payments.lk (card checkout; secret stays on the server) ---
# Sandbox key from https://app.payments.lk/admin/developers
# PAYMENTS_LK_SECRET_KEY=sk_test_...
# Webhook URL to paste: https://quickbite-2ao.pages.dev/webhooks/payments-lk
# PAYMENTS_LK_WEBHOOK_SECRET=whsec_...
